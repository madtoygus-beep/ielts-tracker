rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH / ROLE HELPERS
    // ============================================================

    function isAuth() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isApprovedUser() {
      return isAuth()
        && userDoc(request.auth.uid).data.status == 'approved'
        && userDoc(request.auth.uid).data.get('deleted', false) != true;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function schoolIdOf(data) {
      return data.get('schoolId', 'maxima');
    }

    function currentSchoolId() {
      return schoolIdOf(userDoc(request.auth.uid).data);
    }

    // Stage 17D: student/teacher product access requires a real, active school.
    // Admin deliberately does not depend on school status so the platform admin
    // can still manage and reactivate a school after it has been suspended.
    function schoolIsActive(schoolId) {
      let schoolPath = /databases/$(database)/documents/schools/$(schoolId);
      return exists(schoolPath)
        && get(schoolPath).data.get('status', 'inactive') == 'active';
    }

    function currentSchoolIsActive() {
      return isApprovedUser() && schoolIsActive(currentSchoolId());
    }

    function isAdmin() {
      return isApprovedUser()
        && userDoc(request.auth.uid).data.role == 'admin';
    }

    function isTeacher() {
      return isApprovedUser()
        && userDoc(request.auth.uid).data.role == 'teacher'
        && currentSchoolIsActive();
    }

    function isStudent() {
      return isApprovedUser()
        && userDoc(request.auth.uid).data.role == 'student'
        && currentSchoolIsActive();
    }

    function sameSchool(data) {
      return isApprovedUser() && schoolIdOf(data) == currentSchoolId();
    }

    function teacherIdsOf(data) {
      return data.get('teacherIds', []).size() > 0
        ? data.get('teacherIds', [])
        : data.get('teacherId', '') != ''
          ? [data.get('teacherId', '')]
          : data.get('createdBy', '') != ''
            ? [data.get('createdBy', '')]
            : [];
    }

    function teacherOwns(data) {
      return isTeacher()
        && (
          data.get('teacherId', '') == request.auth.uid
          || data.get('createdBy', '') == request.auth.uid
          || data.get('teacherIds', []).hasAny([request.auth.uid])
        );
    }

    function isSchoolLibraryItem(data) {
      return data.get('visibility', data.get('libraryVisibility', 'private')) == 'school';
    }

    function teacherCanReadContent(data) {
      return isTeacher()
        && (
          teacherOwns(data)
          || (sameSchool(data) && isSchoolLibraryItem(data))
        );
    }

    function teacherCanCreateContent(data) {
      return isTeacher()
        && schoolIdOf(data) == currentSchoolId()
        && (
          data.get('teacherId', '') == request.auth.uid
          || data.get('createdBy', '') == request.auth.uid
          || data.get('teacherIds', []).hasAny([request.auth.uid])
        );
    }

    function teacherCanUpdateContent() {
      return teacherOwns(resource.data)
        && teacherOwns(request.resource.data)
        && schoolIdOf(request.resource.data) == schoolIdOf(resource.data)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');
    }

    function teacherCanReadUser() {
      return isTeacher()
        && (
          resource.data.get('teacherIds', []).hasAny([request.auth.uid])
          || (
            resource.data.role == 'teacher'
            && sameSchool(resource.data)
          )
        );
    }

    function teacherCanReadClass() {
      return isTeacher()
        && sameSchool(resource.data)
        && (
          resource.data.get('teacherId', '') == request.auth.uid
          || resource.data.get('createdBy', '') == request.auth.uid
          || resource.data.get('teacherIds', []).hasAny([request.auth.uid])
        );
    }

    function privilegedFieldsUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'fullName', 'updatedAt'
        ])
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.get('deleted', false) == resource.data.get('deleted', false)
        && request.resource.data.get('requestedRole', null) == resource.data.get('requestedRole', null)
        && request.resource.data.get('approvedAt', null) == resource.data.get('approvedAt', null)
        && request.resource.data.get('rejectedAt', null) == resource.data.get('rejectedAt', null)
        && request.resource.data.get('schoolId', 'maxima') == resource.data.get('schoolId', 'maxima')
        && request.resource.data.get('teacherIds', []) == resource.data.get('teacherIds', [])
        && request.resource.data.get('email', '') == resource.data.get('email', '')
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    // ============================================================
    // STAGE 16F-I: CANONICAL STUDENTACCESS AUTHORIZATION
    // Student entitlement reads are now authorized by studentAccess.
    // Legacy assignment arrays remain on source documents only as migration /
    // teacher-authoring compatibility data; rules no longer trust them.
    // ============================================================

    function studentHasActiveAccess(contentType, contentId) {
      let uid = request.auth != null ? request.auth.uid : '';
      let accessId = uid + '_' + contentType + '_' + contentId;
      let accessPath = /databases/$(database)/documents/studentAccess/$(accessId);
      return isStudent()
        && exists(accessPath)
        && get(accessPath).data.get('uid', '') == request.auth.uid
        && get(accessPath).data.get('contentType', '') == contentType
        && get(accessPath).data.get('contentId', '') == contentId
        && get(accessPath).data.get('status', '') == 'active'
        && schoolIdOf(get(accessPath).data) == currentSchoolId();
    }

    // ============================================================
    // REPAIR 08B: ASSIGNED MOCK -> LINKED RESOURCE ACCESS
    // A student may request a narrow reference, not grant arbitrary permission.
    // Every source read revalidates the LIVE mock and LIVE source documents.
    // No answers, scores, assignment arrays or source copies are written here.
    // ============================================================

    function supportedMockSource(collectionName) {
      return collectionName in ['readings', 'listenings', 'writingHomeworks'];
    }

    function activeMockForCurrentStudent(mockData, mockTestId) {
      return studentHasActiveAccess('mock', mockTestId)
        && schoolIdOf(mockData) == currentSchoolId()
        && mockData.get('archived', false) != true;
    }

    function mockSectionAllowsResource(mockData, collectionName) {
      let rawType = mockData.get('mockType', '');
      let mockType = rawType is string && rawType != ''
        ? rawType : mockData.get('contentType', 'full_mock');
      let stored = mockData.get('enabledSections', {});
      let enabled = stored is map ? stored : {};
      let hasExplicitSelection = enabled.get('listening', false) == true
        || enabled.get('reading', false) == true
        || enabled.get('writing', false) == true;
      let section = collectionName == 'readings' ? 'reading'
        : collectionName == 'listenings' ? 'listening' : 'writing';
      // This mirrors getMockEnabledSections: legacy/all-false records infer
      // sections from their actual links. mockLinksResource checks those links.
      return mockType != 'mini_mock' || !hasExplicitSelection
        || enabled.get(section, false) == true;
    }

    function mockLinksResource(mockData, collectionName, sourceId) {
      let readingIds = mockData.get('readingIds', null);
      let listeningIds = mockData.get('listeningIds', null);
      return mockSectionAllowsResource(mockData, collectionName)
        && (
          (collectionName == 'readings' && (
            readingIds is list ? readingIds.hasAny([sourceId])
              : mockData.get('readingId', '') == sourceId
          ))
          || (collectionName == 'listenings' && (
            listeningIds is list ? listeningIds.hasAny([sourceId])
              : mockData.get('listeningId', '') == sourceId
          ))
          || (collectionName == 'writingHomeworks'
            && mockData.get('writingId', '') == sourceId)
        );
    }

    function mockCreatorCanUseSource(mockData, sourceData) {
      let createdBy = mockData.get('createdBy', '');
      let ownerId = createdBy != '' ? createdBy : mockData.get('teacherId', '');
      // A mock must not become a route to another teacher's private library.
      // The creator field is immutable for teachers; legacy teacherId is locked
      // on updates below when createdBy is absent.
      return isSchoolLibraryItem(sourceData)
        || (ownerId is string && ownerId != '' && (
          sourceData.get('createdBy', '') == ownerId
          || sourceData.get('teacherId', '') == ownerId
          || sourceData.get('teacherIds', []).hasAny([ownerId])
          || (exists(/databases/$(database)/documents/users/$(ownerId))
            && userDoc(ownerId).data.get('role', '') == 'admin'
            && userDoc(ownerId).data.get('status', '') == 'approved'
            && userDoc(ownerId).data.get('deleted', false) != true)
        ));
    }

    function validMockResourceContext(mockData, mockTestId, sourceData, collectionName, sourceId) {
      return activeMockForCurrentStudent(mockData, mockTestId)
        && schoolIdOf(sourceData) == schoolIdOf(mockData)
        && mockLinksResource(mockData, collectionName, sourceId)
        && mockCreatorCanUseSource(mockData, sourceData);
      // Source archived/hidden flags apply to standalone homework lists.
      // A teacher may still deliberately use that existing source in an active
      // assigned mock. Unassign/archive/hide the MOCK to revoke this access.
    }

    function validMockAccessReference(data, collectionName, sourceId) {
      return supportedMockSource(collectionName)
        && data.get('uid', '') == request.auth.uid
        && data.get('sourceCollection', '') == collectionName
        && data.get('sourceId', '') == sourceId
        && data.get('mockTestId', '') is string
        && data.get('mockTestId', '') != ''
        && data.mockTestId.matches('^[^/]+$')
        && exists(/databases/$(database)/documents/mockTests/$(data.mockTestId))
        && exists(/databases/$(database)/documents/$(collectionName)/$(sourceId))
        && validMockResourceContext(
          get(/databases/$(database)/documents/mockTests/$(data.mockTestId)).data,
          data.mockTestId,
          get(/databases/$(database)/documents/$(collectionName)/$(sourceId)).data,
          collectionName,
          sourceId
        );
    }

    function studentCanGetMockResource(collectionName, sourceId) {
      return isStudent()
        && exists(/databases/$(database)/documents/mockResourceAccess/$(request.auth.uid)/$(collectionName)/$(sourceId))
        && validMockAccessReference(
          get(/databases/$(database)/documents/mockResourceAccess/$(request.auth.uid)/$(collectionName)/$(sourceId)).data,
          collectionName,
          sourceId
        );
    }

    // REPAIR MOCK-WRITING-R1: read-only fast path for a linked private Writing.
    // The generic grant validator above is retained for WRITE validation and
    // objective resources. Calling it from a Writing GET re-fetches the very
    // source document being read, causing Firestore's 1000-expression limit.
    // Here resource.data is already the live Writing document: validate against
    // it directly while rechecking the active mock assignment and source owner.
    function mockWritingGrantContext(mockData, mockId, sourceId, sourceData) {
      return studentHasActiveAccess('mock', mockId)
        && schoolIdOf(mockData) == currentSchoolId()
        && mockData.get('archived', false) != true
        && schoolIdOf(sourceData) == schoolIdOf(mockData)
        && mockLinksResource(mockData, 'writingHomeworks', sourceId)
        && mockCreatorCanUseSource(mockData, sourceData);
    }

    function mockWritingGrantSource(grant, sourceId, sourceData) {
      let mockId = grant.get('mockTestId', '');
      let mockPath = /databases/$(database)/documents/mockTests/$(mockId);
      return grant.get('uid', '') == request.auth.uid
        && grant.get('sourceCollection', '') == 'writingHomeworks'
        && grant.get('sourceId', '') == sourceId
        && grant.get('schemaVersion', 0) == 1
        && mockId is string && mockId != '' && mockId.matches('^[^/]+$')
        && exists(mockPath)
        && mockWritingGrantContext(get(mockPath).data, mockId, sourceId, sourceData);
    }

    function studentCanGetMockWriting(sourceId, sourceData) {
      let uid = request.auth != null ? request.auth.uid : '';
      let grantPath = /databases/$(database)/documents/mockResourceAccess/$(uid)/writingHomeworks/$(sourceId);
      return isStudent()
        && exists(grantPath)
        && mockWritingGrantSource(get(grantPath).data, sourceId, sourceData);
    }

    match /mockResourceAccess/{studentId}/{collectionName}/{sourceId} {
      // DoMockTest creates this only after a denied direct read. Rules validate
      // the active Mock studentAccess entitlement and exact source link first.
      allow create, update: if isStudent()
        && studentId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'mockTestId', 'sourceCollection', 'sourceId',
          'schemaVersion', 'updatedAt'
        ])
        && request.resource.data.get('schemaVersion', 0) == 1
        && request.resource.data.get('updatedAt', null) == request.time
        && validMockAccessReference(request.resource.data, collectionName, sourceId);

      allow get: if isAdmin() || (isStudent() && studentId == request.auth.uid);
      allow list: if false;
      allow delete: if isAdmin() || (isStudent() && studentId == request.auth.uid);
    }

    function validStudentSubmissionBase(data, parentData) {
      return isStudent()
        && data.uid == request.auth.uid
        && data.get('studentId', '') == request.auth.uid
        && schoolIdOf(data) == schoolIdOf(parentData)
        && schoolIdOf(parentData) == currentSchoolId()
        && teacherIdsOf(parentData).size() > 0
        && (
          data.get('teacherIds', []) == teacherIdsOf(parentData)
          || data.get('teacherIds', []) == clientTeacherIdsOf(parentData)
        )
        && data.get('teacherId', '') == teacherIdsOf(parentData)[0]
        && parentData.get('archived', false) != true;
    }

    // Repair 08C: new student submissions use one deterministic document
    // per student + assignment. Student updates remain forbidden, so a second
    // attempt becomes an update request and is denied.
    function expectedSubmissionId(parentId) {
      return request.auth.uid + '_' + parentId;
    }

    function hasExpectedSubmissionId(documentId, parentId) {
      return isStudent()
        && parentId is string
        && parentId != ''
        && documentId == expectedSubmissionId(parentId);
    }

    // Q1A: prevent browser callers from falsifying exclusion metadata.
    // Server callables use Admin SDK and are not subject to Firestore rules.
    function statsModerationFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'excludedFromStats', 'statsExcludedAt',
        'statsExcludedBy', 'statsChangedAt', 'statsChangedBy'
      ]);
    }

    function teacherListedOn(data) {
      return isTeacher()
        && (
          data.get('teacherId', '') == request.auth.uid
          || data.get('teacherIds', []).hasAny([request.auth.uid])
          || data.get('addedBy', '') == request.auth.uid
        );
    }

    // ============================================================
    // REPAIR 08A: INITIAL RECORD VALIDATION (NO DATA MIGRATION)
    // These checks validate shape and ownership, not answer correctness.
    // Client-side scoring remains in this release; Repair 08C locks new submissions
    // to deterministic document IDs. Existing random-ID submissions remain readable.
    // REPAIR 08B above now restricts reads to assignments or validated Mock links.
    // ============================================================

    function clientTeacherIdsOf(data) {
      let teacherId = data.get('teacherId', '');
      let createdBy = data.get('createdBy', '');
      return data.get('teacherIds', []).size() > 0
        ? data.get('teacherIds', [])
        : teacherId != ''
          ? (createdBy != '' && createdBy != teacherId
            ? [teacherId, createdBy] : [teacherId])
          : (createdBy != '' ? [createdBy] : []);
    }

    function initialSubmissionFields() {
      return [
        'uid', 'studentId', 'studentEmail', 'studentName', 'schoolId',
        'teacherId', 'teacherIds', 'submittedAt', 'finishedLate',
        'autoSubmitted', 'archived'
      ];
    }

    function validInitialSubmissionFields(data, extraFields) {
      return data.keys().hasOnly(initialSubmissionFields().concat(extraFields))
        && data.submittedAt is string
        && data.get('studentEmail', '') is string
        && data.get('studentName', '') is string
        && data.get('finishedLate', false) is bool
        && data.get('autoSubmitted', false) is bool
        && data.get('archived', false) == false;
    }

    function validBandOrNull(value) {
      return value == null || (value is number && value >= 0 && value <= 9);
    }

    function validBandOrBlank(value) {
      return value == '' || (value is number && value >= 0 && value <= 9);
    }

    function validCounts(result) {
      return result is map
        && result.correct is int && result.total is int
        && result.total >= 0 && result.correct >= 0
        && result.correct <= result.total;
    }

    function validObjectiveResult(result) {
      return validCounts(result)
        && result.keys().hasOnly(['correct', 'total', 'band', 'percentage'])
        && validBandOrNull(result.get('band', null))
        && result.get('percentage', 0) is number
        && result.get('percentage', 0) >= 0
        && result.get('percentage', 0) <= 100;
    }

    function validObjectiveSubmission(data, parentField) {
      return validInitialSubmissionFields(data, [
          parentField, 'answers', 'result', 'flaggedQuestions',
          'studentNote', 'highlights'
        ])
        && data.answers is map
        && validObjectiveResult(data.result)
        && data.get('flaggedQuestions', []) is list
        && data.get('studentNote', '') is string;
    }

    function validVocabularySubmission(data) {
      return validInitialSubmissionFields(data, [
          'vocabularyTestId', 'vocabularyId', 'testId', 'homeworkId',
          'vocabularyTitle', 'matchingViewVersion', 'answers', 'result'
        ])
        && data.answers is map
        && validObjectiveResult(data.result)
        && data.get('vocabularyId', data.vocabularyTestId) == data.vocabularyTestId
        && data.get('testId', data.vocabularyTestId) == data.vocabularyTestId
        && data.get('homeworkId', data.vocabularyTestId) == data.vocabularyTestId
        && data.get('matchingViewVersion', 1) == 1;
    }

    function validWritingSubmission(data) {
      return validInitialSubmissionFields(data, [
          'writingId', 'contentType', 'writingMode', 'task1Enabled',
          'task2Enabled', 'task1Answer', 'task2Answer', 'task1WordCount',
          'task2WordCount', 'reviewed', 'review'
        ])
        && data.task1Answer is string && data.task2Answer is string
        && data.task1WordCount is int && data.task1WordCount >= 0
        && data.task2WordCount is int && data.task2WordCount >= 0
        && data.get('task1Enabled', true) is bool
        && data.get('task2Enabled', true) is bool
        && data.get('reviewed', false) == false
        && data.get('review', null) == null;
    }

    function validMockSkillResult(result) {
      return validCounts(result)
        && result.keys().hasOnly([
          'enabled', 'correct', 'total', 'band', 'passages'
        ])
        && result.get('enabled', true) is bool
        && validBandOrNull(result.get('band', null))
        && result.get('passages', []) is list;
    }

    function validInitialMockWriting(result) {
      return result is map
        && result.keys().hasOnly([
          'enabled', 'status', 'writingMode', 'task1Enabled', 'task2Enabled',
          'task1WordCount', 'task2WordCount'
        ])
        && result.get('enabled', true) is bool
        && result.get('status', '') == (result.get('enabled', true)
          ? 'pending_review' : 'not_included')
        && result.get('task1Enabled', true) is bool
        && result.get('task2Enabled', true) is bool
        && result.task1WordCount is int && result.task1WordCount >= 0
        && result.task2WordCount is int && result.task2WordCount >= 0;
    }

    function validInitialMockResult(result) {
      return result is map
        && result.keys().hasOnly([
          'enabledSections', 'listening', 'reading', 'writing', 'overallEstimate'
        ])
        && validMockSkillResult(result.listening)
        && validMockSkillResult(result.reading)
        && validInitialMockWriting(result.writing)
        && validBandOrNull(result.get('overallEstimate', null));
    }

    function validMockSubmission(data) {
      return validInitialSubmissionFields(data, [
          'mockTestId', 'title', 'mockType', 'contentType', 'enabledSections',
          'writingMode', 'task1Enabled', 'task2Enabled', 'sectionTimeLimits',
          'listeningId', 'listeningIds', 'readingIds', 'writingId',
          'listeningAnswers', 'readingAnswers', 'writingAnswers', 'result',
          'tabSwitchCount', 'timing', 'status'
        ])
        && data.listeningAnswers is map && data.readingAnswers is map
        && data.writingAnswers is map
        && data.writingAnswers.keys().hasOnly(['task1', 'task2'])
        && data.writingAnswers.get('task1', '') is string
        && data.writingAnswers.get('task2', '') is string
        && data.get('status', 'submitted') == 'submitted'
        && validInitialMockResult(data.result);
    }

    function validInitialMockScoreFields(data) {
      return data.keys().hasOnly([
          'uid', 'studentId', 'studentEmail', 'schoolId', 'teacherId',
          'teacherIds', 'date', 'source', 'mockTestId', 'listening',
          'reading', 'writing', 'speaking', 'overall', 'createdAt'
        ])
        && data.get('writing', '') == '' && data.get('speaking', '') == ''
        && validBandOrBlank(data.get('listening', ''))
        && validBandOrBlank(data.get('reading', ''))
        && validBandOrBlank(data.get('overall', ''));
    }

    function validVocabularyDraftFields(data) {
      // Unknown existing metadata is preserved by Repair 07 mergeFields.
      // A draft is never accepted as a graded submission.
      return data.answers is map
        && data.timeLeft is number && data.timeLeft >= 0
        && data.updatedAt is string
        && data.get('vocabularyId', data.vocabularyTestId) == data.vocabularyTestId
        && data.get('testId', data.vocabularyTestId) == data.vocabularyTestId
        && data.get('homeworkId', data.vocabularyTestId) == data.vocabularyTestId;
    }

    function teacherMessageIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'senderId', 'teacherId', 'teacherIds', 'schoolId', 'createdAt'
      ]);
    }

    function studentAddsOnlyOwnReadReceipt() {
      let before = resource.data.get('readBy', []);
      let after = request.resource.data.get('readBy', []);
      return before is list && after is list
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && after.hasAll(before)
        && after.hasAny([request.auth.uid])
        && after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
        && after.size() == after.toSet().size();
    }

    function teacherMaterialIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'ownerId', 'teacherId', 'teacherIds', 'schoolId', 'storagePath', 'createdAt', 'readBy'
      ]);
    }

    // ============================================================
    // STAGE 17D: SCHOOLS / INSTITUTIONS
    // ============================================================
    // School metadata is managed only through admin-authorized Cloud Functions.
    // Client reads/writes remain blocked; rules may internally read school status
    // to enforce active/inactive access for students and teachers.

    match /schools/{schoolId} {
      allow read, create, update, delete: if false;
    }

    // ============================================================
    // USERS
    // ============================================================

    // Stage 18B: user provisioning and privileged account changes are server-only.
    // Admin SDK Cloud Functions create/approve/reject/edit/delete managed accounts and
    // bypass these client rules. End users may only update their own non-privileged
    // profile fields already covered by privilegedFieldsUnchanged().
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId) || teacherCanReadUser();

      allow create: if false;

      allow update: if isOwner(userId) && privilegedFieldsUnchanged();

      allow delete: if false;
    }

    // P2B: school username -> UID resolution is server-only. The browser never
    // reads this mapping, so username login does not expose the account email.
    match /managedUsernames/{usernameId} {
      allow read, create, update, delete: if false;
    }

    // ============================================================
    // P4C: Independent Master Content Library (server-only).
    // Answer keys and independent assessment copies are NEVER available
    // through client Firestore access, including platform managers/admins.
    // Dedicated Cloud Functions enforce exact role/scope checks.
    // ============================================================

    match /masterContent/{masterId} {
      allow read, write: if false;
    }

    // P4D: price/catalog state, access grants and learner attempts must be
    // server-authoritative. The browser cannot read or forge these records.
    match /selfStudyPackages/{packageId} {
      allow read, write: if false;
    }
    match /selfStudyEntitlements/{entitlementId} {
      allow read, write: if false;
    }
    match /selfStudySettings/{settingsId} {
      allow read, write: if false;
    }
    match /selfStudyAttempts/{attemptId} {
      allow read, write: if false;
    }

    // ============================================================
    // CLASSES
    // ============================================================

    // P1B: class reads are school-scoped. All class writes are server-only
    // through saveManagedClass / setManagedClassArchived / deleteManagedClass.
    // Admin SDK Cloud Functions bypass client rules and enforce the authoritative
    // school, teacher and student relationship before writing.
    match /classes/{classId} {
      allow read: if isAdmin()
        || teacherCanReadClass()
        || (
          isStudent()
          && sameSchool(resource.data)
          && resource.data.get('studentIds', []).hasAny([request.auth.uid])
        );

      allow create, update, delete: if false;
    }

    // ============================================================
    // SCORES
    // ============================================================

    function mockForScoreExists(data) {
      return data.get('mockTestId', '') != ''
        && exists(/databases/$(database)/documents/mockTests/$(data.mockTestId));
    }

    function teacherOwnsScoreMock(data) {
      return mockForScoreExists(data)
        && teacherOwns(
          get(/databases/$(database)/documents/mockTests/$(data.mockTestId)).data
        );
    }

    function validStudentMockScore(data) {
      return isStudent()
        && data.uid == request.auth.uid
        && data.get('studentId', '') == request.auth.uid
        && data.get('source', '') == 'mock_test'
        && validInitialMockScoreFields(data)
        && mockForScoreExists(data)
        && studentHasActiveAccess('mock', data.mockTestId)
        && validStudentSubmissionBase(
          data,
          get(/databases/$(database)/documents/mockTests/$(data.mockTestId)).data
        );
    }

    // Q2C-2: Students use getStudentVisibleResults (trusted Cloud Function).
    // Browser get and collection queries are both denied, even for own uid,
    // because Firestore queries cannot enforce archive + access joins safely.
    match /scores/{scoreId} {
      allow get, list: if isAdmin()
        || teacherListedOn(resource.data)
        || teacherOwnsScoreMock(resource.data);

      // 8D-2: objective/mock scores are server-authored for students.
      // Teachers/admins keep their existing manual score path.
      allow create: if isAdmin()
        || (
          isTeacher()
          && teacherListedOn(request.resource.data)
          && schoolIdOf(request.resource.data) == currentSchoolId()
          && userDoc(request.resource.data.uid).data.get('teacherIds', []).hasAny([request.auth.uid])
        );

      allow update: if statsModerationFieldsUnchanged() && (
        isAdmin()
        || teacherListedOn(resource.data)
        || teacherOwnsScoreMock(resource.data)
      );
      allow delete: if false; // Q1B-B audited server deletion only
    }

    // ============================================================
    // STAGE 16D / 16F-I: CANONICAL STUDENT ACCESS
    // Server-side triggers create these documents from the existing teacher
    // assignment workflow. studentAccess is now authoritative for students.
    // ============================================================

    match /studentAccess/{accessId} {
      allow get, list: if isAdmin()
        || (
          isStudent()
          && resource.data.get('uid', '') == request.auth.uid
          && schoolIdOf(resource.data) == currentSchoolId()
        );

      // Cloud Functions / Admin SDK only during the migration period.
      allow create, update, delete: if false;
    }

    // ============================================================
    // 8D-2 SANITIZED STUDENT CONTENT PROJECTIONS
    // Students read answer-key-free copies here.
    // Standalone access is authorized by studentAccess. Mock Reading/Listening
    // get access is allowed only through the validated mockResourceAccess path.
    // Writes are server-only (Admin SDK / Cloud Functions bypass rules).
    // ============================================================

    // Moderation audit is append-only via trusted backend, never exposed to browsers.
    match /resultModerationAudit/{auditId} {
      allow read, write: if false;
    }

    match /studentReadings/{id} {
      allow get: if isAdmin()
        || (isStudent() && (
          studentHasActiveAccess('reading', id)
          || studentCanGetMockResource('readings', id)
        ));

      allow list: if isAdmin();

      allow create, update, delete: if false;
    }

    match /studentListenings/{id} {
      allow get: if isAdmin()
        || (isStudent() && (
          studentHasActiveAccess('listening', id)
          || studentCanGetMockResource('listenings', id)
        ));

      allow list: if isAdmin();

      allow create, update, delete: if false;
    }

    match /studentVocabularyTests/{id} {
      allow get: if isAdmin()
        || studentHasActiveAccess('vocabulary', id);

      allow list: if isAdmin();

      allow create, update, delete: if false;
    }

    // ============================================================
    // READING
    // ============================================================

    match /readings/{id} {
      // 8D-2 final cutover: students never read answer-key-bearing source docs.
      // Student and Mock flows use studentReadings projections instead.
      allow get, list: if isAdmin()
        || teacherCanReadContent(resource.data);

      allow create: if isAdmin() || teacherCanCreateContent(request.resource.data);
      allow update: if isAdmin() || teacherCanUpdateContent();
      allow delete: if false; // Q1B-B audited server deletion only
    }

    function readingParentExists(data) {
      return data.get('readingId', '') != ''
        && exists(/databases/$(database)/documents/readings/$(data.readingId));
    }

    function teacherOwnsReadingParent(data) {
      return readingParentExists(data)
        && teacherOwns(
          get(/databases/$(database)/documents/readings/$(data.readingId)).data
        );
    }

    // Q2C-2: Students use getStudentVisibleResults (trusted Cloud Function).
    // Browser get and collection queries are both denied, even for own uid,
    // because Firestore queries cannot enforce archive + access joins safely.
    match /readingSubmissions/{id} {
      allow get, list: if isAdmin()
        || teacherListedOn(resource.data)
        || teacherOwnsReadingParent(resource.data);

      // 8D-2: student Reading submissions are created only by submitReadingSecure.
      // Cloud Functions use the Admin SDK and bypass Firestore client rules.
      allow create: if isAdmin();

      allow update: if statsModerationFieldsUnchanged() && (
        isAdmin()
        || teacherListedOn(resource.data)
        || teacherOwnsReadingParent(resource.data)
      );
      allow delete: if false; // Q1B-B audited server deletion only
    }

    // ============================================================
    // LISTENING
    // ============================================================

    match /listenings/{id} {
      // 8D-2 final cutover: students never read answer-key-bearing source docs.
      // Student and Mock flows use studentListenings projections instead.
      allow get, list: if isAdmin()
        || teacherCanReadContent(resource.data);

      allow create: if isAdmin() || teacherCanCreateContent(request.resource.data);
      allow update: if isAdmin() || teacherCanUpdateContent();
      allow delete: if false; // Q1B-B audited server deletion only
    }

    function listeningParentExists(data) {
      return data.get('listeningId', '') != ''
        && exists(/databases/$(database)/documents/listenings/$(data.listeningId));
    }

    function teacherOwnsListeningParent(data) {
      return listeningParentExists(data)
        && teacherOwns(
          get(/databases/$(database)/documents/listenings/$(data.listeningId)).data
        );
    }

    // Q2C-2: Students use getStudentVisibleResults (trusted Cloud Function).
    // Browser get and collection queries are both denied, even for own uid,
    // because Firestore queries cannot enforce archive + access joins safely.
    match /listeningSubmissions/{id} {
      allow get, list: if isAdmin()
        || teacherListedOn(resource.data)
        || teacherOwnsListeningParent(resource.data);

      // 8D-2: student Listening submissions are created only by submitListeningSecure.
      allow create: if isAdmin();

      allow update: if statsModerationFieldsUnchanged() && (
        isAdmin()
        || teacherListedOn(resource.data)
        || teacherOwnsListeningParent(resource.data)
      );
      allow delete: if false; // Q1B-B audited server deletion only
    }

    // ============================================================
    // WRITING
    // ============================================================

    match /writingHomeworks/{id} {
      // R2: validate Mock grant FIRST to avoid exhausting the 1,000-expression budget.
      // The same admin/teacher/standalone-student checks remain as fallbacks.
      allow get: if studentCanGetMockWriting(id, resource.data)
        || isAdmin()
        || teacherCanReadContent(resource.data)
        || studentHasActiveAccess('writing', id);

      // A mock reference permits a single linked document, not library queries.
      allow list: if isAdmin()
        || teacherCanReadContent(resource.data);

      allow create: if isAdmin() || teacherCanCreateContent(request.resource.data);
      allow update: if isAdmin() || teacherCanUpdateContent();
      allow delete: if false; // Q1B-B audited server deletion only
    }

    function writingParentExists(data) {
      return data.get('writingId', '') != ''
        && exists(/databases/$(database)/documents/writingHomeworks/$(data.writingId));
    }

    function teacherOwnsWritingParent(data) {
      return writingParentExists(data)
        && teacherOwns(
          get(/databases/$(database)/documents/writingHomeworks/$(data.writingId)).data
        );
    }

    // Q2C-2: Students use getStudentVisibleResults (trusted Cloud Function).
    // Browser get and collection queries are both denied, even for own uid,
    // because Firestore queries cannot enforce archive + access joins safely.
    match /writingSubmissions/{id} {
      allow get, list: if isAdmin()
        || teacherListedOn(resource.data)
        || teacherOwnsWritingParent(resource.data);

      // Stage 16L-2B3: student Writing submissions are server-authored by
      // submitWritingSecure. Cloud Functions use the Admin SDK and bypass rules.
      allow create: if isAdmin();

      allow update: if statsModerationFieldsUnchanged() && (
        isAdmin()
        || teacherListedOn(resource.data)
        || teacherOwnsWritingParent(resource.data)
      );
      allow delete: if false; // Q1B-B audited server deletion only
    }

    // ============================================================
    // MOCK TESTS
    // ============================================================

    match /mockTests/{id} {
      allow get: if isAdmin()
        || teacherCanReadContent(resource.data)
        || studentHasActiveAccess('mock', id);

      allow list: if isAdmin()
        || teacherCanReadContent(resource.data);

      allow create: if isAdmin() || (
        teacherCanCreateContent(request.resource.data)
        && request.resource.data.get('createdBy', '') == request.auth.uid
      );
      allow update: if isAdmin() || (
        teacherCanUpdateContent()
        && (resource.data.get('createdBy', '') != ''
          || request.resource.data.get('teacherId', '') == resource.data.get('teacherId', ''))
      );
      allow delete: if false; // Q1B-B audited server deletion only
    }

    function mockParentExists(data) {
      return data.get('mockTestId', '') != ''
        && exists(/databases/$(database)/documents/mockTests/$(data.mockTestId));
    }

    function teacherOwnsMockParent(data) {
      return mockParentExists(data)
        && teacherOwns(
          get(/databases/$(database)/documents/mockTests/$(data.mockTestId)).data
        );
    }

    // Q2C-2: Students use getStudentVisibleResults (trusted Cloud Function).
    // Browser get and collection queries are both denied, even for own uid,
    // because Firestore queries cannot enforce archive + access joins safely.
    match /mockSubmissions/{id} {
      allow get, list: if isAdmin()
        || teacherListedOn(resource.data)
        || teacherOwnsMockParent(resource.data);

      // 8D-2: student Mock submissions are created only by submitMockSecure.
      allow create: if isAdmin();

      allow update: if statsModerationFieldsUnchanged() && (
        isAdmin()
        || teacherListedOn(resource.data)
        || teacherOwnsMockParent(resource.data)
      );
      allow delete: if false; // Q1B-B audited server deletion only
    }

    // ============================================================
    // VOCABULARY
    // ============================================================

    match /vocabularyTests/{id} {
      // 8D-2 final cutover: students use studentVocabularyTests projections.
      allow read: if isAdmin()
        || teacherCanReadContent(resource.data);

      allow create: if isAdmin() || teacherCanCreateContent(request.resource.data);
      allow update: if isAdmin() || teacherCanUpdateContent();
      allow delete: if false; // Q1B-B audited server deletion only
    }

    function vocabularyParentExists(data) {
      return data.get('vocabularyTestId', '') != ''
        && exists(/databases/$(database)/documents/vocabularyTests/$(data.vocabularyTestId));
    }

    function teacherOwnsVocabularyParent(data) {
      return vocabularyParentExists(data)
        && teacherOwns(
          get(/databases/$(database)/documents/vocabularyTests/$(data.vocabularyTestId)).data
        );
    }

    // Q2C-2: Students use getStudentVisibleResults (trusted Cloud Function).
    // Browser get and collection queries are both denied, even for own uid,
    // because Firestore queries cannot enforce archive + access joins safely.
    match /vocabularySubmissions/{id} {
      allow get, list: if isAdmin()
        || teacherListedOn(resource.data)
        || teacherOwnsVocabularyParent(resource.data);

      // 8D-2: student Vocabulary submissions are created only by submitVocabularySecure.
      allow create: if isAdmin();

      allow update: if statsModerationFieldsUnchanged() && (
        isAdmin()
        || teacherListedOn(resource.data)
        || teacherOwnsVocabularyParent(resource.data)
      );
      allow delete: if false; // Q1B-B audited server deletion only
    }
    // ============================================================
    // VOCABULARY DRAFTS / SAVE & CONTINUE LATER
    // ============================================================

    match /vocabularyDrafts/{draftId} {
      // Students can only read their own saved draft.
      // Admin can read drafts for support/maintenance if needed.
      allow read: if isAdmin()
        || (
          isStudent()
          && request.method == 'get'
          && draftId.size() > request.auth.uid.size() + 1
          && draftId[0:request.auth.uid.size() + 1] == request.auth.uid + '_'
          && !exists(/databases/$(database)/documents/vocabularyDrafts/$(draftId))
        )
        || (
          isStudent()
          && resource.data.get('uid', '') == request.auth.uid
          && resource.data.get('studentId', '') == request.auth.uid
          && draftId == request.auth.uid + '_' + resource.data.get('vocabularyTestId', '')
        );

      // Package 49 uses setDoc(..., { merge: true }), so create and update
      // both validate the complete resulting document against the canonical
      // studentAccess entitlement and the vocabulary test.
      allow create, update: if vocabularyParentExists(request.resource.data)
        && studentHasActiveAccess('vocabulary', request.resource.data.get('vocabularyTestId', ''))
        && validStudentSubmissionBase(
          request.resource.data,
          get(
            /databases/$(database)/documents/vocabularyTests/$(request.resource.data.vocabularyTestId)
          ).data
        )
        && draftId == request.auth.uid + '_' + request.resource.data.vocabularyTestId
        && validVocabularyDraftFields(request.resource.data);

      // Final submission removes the student's draft.
      allow delete: if isAdmin()
        || (
          isStudent()
          && resource.data.get('uid', '') == request.auth.uid
          && resource.data.get('studentId', '') == request.auth.uid
          && draftId == request.auth.uid + '_' + resource.data.get('vocabularyTestId', '')
        );
    }

    // ============================================================
    // MESSAGES
    // ============================================================

    function isMessageRecipient(data) {
      return isStudent()
        && data.get('recipientIds', []).hasAny([request.auth.uid]);
    }

    match /messages/{messageId} {
      allow read: if isAdmin()
        || teacherListedOn(resource.data)
        || isMessageRecipient(resource.data);

      allow create: if isAdmin()
        || (
          isTeacher()
          && schoolIdOf(request.resource.data) == currentSchoolId()
          && request.resource.data.get('senderId', '') == request.auth.uid
          && request.resource.data.get('teacherId', '') == request.auth.uid
          && request.resource.data.get('teacherIds', []) == [request.auth.uid]
          && request.resource.data.get('recipientIds', []) is list
          && request.resource.data.get('recipientIds', []).size() > 0
          && request.resource.data.get('readBy', []) == []
        );

      allow update: if isAdmin()
        || (teacherListedOn(resource.data) && teacherMessageIdentityUnchanged())
        || (isMessageRecipient(resource.data) && studentAddsOnlyOwnReadReceipt());

      allow delete: if isAdmin() || teacherListedOn(resource.data);
    }

    // ============================================================
    // MATERIALS
    // ============================================================

    function isMaterialRecipient(data) {
      return isStudent()
        && data.get('recipientIds', []).hasAny([request.auth.uid]);
    }

    match /materials/{materialId} {
      allow read: if isAdmin()
        || teacherListedOn(resource.data)
        || isMaterialRecipient(resource.data);

      allow create: if isAdmin()
        || (
          isTeacher()
          && schoolIdOf(request.resource.data) == currentSchoolId()
          && request.resource.data.get('ownerId', '') == request.auth.uid
          && request.resource.data.get('teacherId', '') == request.auth.uid
          && request.resource.data.get('teacherIds', []) == [request.auth.uid]
          && request.resource.data.get('recipientIds', []) is list
          && request.resource.data.get('recipientIds', []).size() > 0
          && request.resource.data.get('readBy', []) == []
          && request.resource.data.get('storagePath', '') is string
          && request.resource.data.get('storagePath', '').size() >
            ('materials/' + request.auth.uid + '/' + materialId + '/').size()
          && request.resource.data.storagePath[
            0:('materials/' + request.auth.uid + '/' + materialId + '/').size()
          ] == 'materials/' + request.auth.uid + '/' + materialId + '/'
        );

      allow update: if isAdmin()
        || (teacherListedOn(resource.data) && teacherMaterialIdentityUnchanged())
        || (isMaterialRecipient(resource.data) && studentAddsOnlyOwnReadReceipt());
      allow delete: if isAdmin() || teacherListedOn(resource.data);
    }


    // P5A-1: AI Writing pilot control, per-student credit balances and
    // administrator adjustments are server-owned. No browser direct reads,
    // lists, creates, updates or deletes for any role (including Admin).
    match /aiWritingSchoolSettings/{schoolId} {
      allow read, write: if false;
    }

    match /aiWritingStudentAccess/{studentId} {
      allow read, write: if false;
    }

    match /aiWritingCreditOperations/{operationId} {
      allow read, write: if false;
    }

    // AI-generated reports and per-school usage counters are server-only.
    match /aiWritingEvaluations/{evaluationId} {
      allow read, write: if false;
    }

    match /aiWritingMonthlyUsage/{periodId} {
      allow read, write: if false;
    }

    // P5B-3A: instructor-sponsored AI selections are server-only.
    match /aiWritingSponsoredPolicies/{policyId} {
      allow read, write: if false;
    }

  }
}
